# AI Transform Configuration

# LLM Provider: "openai" or "local"
AI_VENDOR=openai

# OpenAI Configuration (required if AI_VENDOR=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview

# Local LLM Configuration (required if AI_VENDOR=local)
# LOCAL_MODEL_URL=http://localhost:8000
# LOCAL_MODEL_NAME=mistral

# Execution Sandbox Configuration
SANDBOX_TIMEOUT_SECONDS=10
SANDBOX_MAX_MEMORY_MB=512

# Dry-run Configuration
DRYRUN_SAMPLE_FRAC=0.02
DRYRUN_MAX_ROWS=10000
